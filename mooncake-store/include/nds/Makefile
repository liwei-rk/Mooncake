# Makefile for NDS Interface

.PHONY: all clean install

all:
	@echo "NDS interface header-only - no compilation needed"

install:
	@echo "Installing NDS interface header..."
	mkdir -p $(DESTDIR)/usr/local/include/nds
	cp nds_interface.h $(DESTDIR)/usr/local/include/nds/
	@echo "Installation complete"

clean:
	@echo "Nothing to clean"